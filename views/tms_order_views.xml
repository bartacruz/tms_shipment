<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <!-- TMS Order Tree View -->
    <record id="tms_order_view_tree" model="ir.ui.view">
        <field name="name">tms.order.view.tree.inherit.tms_shipment</field>
        <field name="model">tms.order</field>
        <field name="inherit_id" ref="tms.tms_order_view_tree" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='start_trip']" position="before">
                <header>
                    <button name="action_create_tms_order" type="object"
                        class="o_button_create_tms_sale btn-primary" string="Nuevo"
                        display="always" />
                </header>
            </xpath>
            <xpath expr="//tree" position="attributes">
                <attribute name="editable">top</attribute>
                <attribute name="create">true</attribute>
                <attribute name="expand">context.get('expand', False)</attribute>
                <attribute name="default_order">create_date desc</attribute>
                <!-- <attribute name="default_group_by">sale_order_label</attribute> -->
            </xpath>
            <xpath expr="//field[@name='name']" position="attributes">
                <attribute name="optional">hide</attribute>
            </xpath>
            <xpath expr="//field[@name='stage_id']" position="attributes">
                <attribute name="widget">badge</attribute>
                <attribute name="decoration-primary">stage_id in [2]</attribute>
                <attribute name="decoration-success">stage_id in [3]</attribute>
                <attribute name="decoration-danger">stage_id in [4]</attribute>

            </xpath>
            <xpath expr="//field[@name='name']" position="after">
                <field name="scheduled_date_start" optional="show" />
                <field name="sale_order_label" optional="hide" />
                <field name="customer_id" optional="hide" />
                <field name="origin_locality_id" readonly="True" />
                <field name="destination_locality_id" readonly="True" />
                <field name="sale_id" optional="hide" readonly="True" />
                <field name="is_active" optional="hide" readonly="True" />
                <field name="is_completed" optional="hide" readonly="True" />

            </xpath>
            <xpath expr="//field[@name='driver_id']" position="attributes">
                <attribute name="context">{'order_display': 'stage_id,sequence','default_is_external':False}</attribute>
            </xpath>
            <xpath expr="//field[@name='driver_id']" position="after">
                <field name="vehicle_id" />
                <field name="trailer_id" />
                <field name="vehicle_label" optional='hide' />
                <field name="cpe_id" />
                
            </xpath>
            <xpath expr="//button[@name='button_end_order']" position="after">
                <field name="description" optional="hide" />
                <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}" />
                <button name="action_open_record_form" type="object" icon="fa-external-link" string="Open" />

            </xpath>
        </field>
    </record>

    <record id="tms_shipment_view_tms_order_search" model="ir.ui.view">
        <field name="name">tms.order.view.search</field>
        <field name="model">tms.order</field>
        <field name="inherit_id" ref="tms.view_tms_order_search" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='stage_id']" position="after">
                <field name="driver_id" />
                <field name="vehicle_id" />
                <filter name="active" string="Activos" domain="[('stage_id','in',[2,6,1])]"/>
                <filter name="finished" string="Finalizados" domain="[('stage_id','in',[3])]"/>
                <filter name="cancelled" string="Cancelados" domain="[('stage_id','in',[4])]"/>
                <filter string="Hoy" name="filter_today_creation"
                    domain="[('create_date','&gt;', (context_today() - datetime.timedelta(days=1)).strftime('%Y-%m-%d'))]" />

                <filter string="Fecha" name="filter_create_date" date="create_date" />
                <group expand="1" string="Group by">
                    <filter string="Pedidos" name="sale" context="{'group_by': 'sale_order_label'}" />
                    <filter string="Clientes" name="customer" context="{'group_by': 'customer_id'}" />
                    <filter string="Etapas" name="stage_id" context="{'group_by': 'stage_id'}" />
                </group>
            </xpath>
        </field>
    </record>

    <!-- TMS Order Form View -->
    <record id="tms_order_view_form" model="ir.ui.view">
        <field name="name">tms.order.view.form.inherit.tms_shipment</field>
        <field name="model">tms.order</field>
        <field name="inherit_id" ref="tms.tms_order_view_form" />
        <field name="arch" type="xml">
            <header position="after">
                <div class="alert alert-warning" role="alert" invisible="not cpe_mismatch" >Warning: Vehicle from CPE mismatches the one in the order.</div>
            </header>
            
            <field name="active" position="after" >
                <field name="name" invisible="1"/>
                <field name="route" invisible="1"/>
                <field name="cpe_mismatch" invisible="1" />
                <field name="cpe_id" invisible="1" />
            </field>

            <div class="oe_title" position="replace">
                <div class="oe_title">
                        <label for="customer_id" class="oe_edit_only" string="Customer" />
                        <h1>
                            <field name="customer_id" />
                        </h1>
                    </div>
            </div>

            <field name="vehicle_id" position="replace" />
            
            <field name="driver_id" position="replace">
                <field name="contact_phone" widget="phone" />
                <field name="origin_id" widget="res_partner_many2one" context="{'show_address': 1, 'show_vat': False}" domain="[('tms_location','=',True),('parent_id','=',customer_id)]" required="False"/>
                <field name="origin_locality_id" />
                <field name="destination_id" widget="res_partner_many2one" context="{'show_address': 1, 'show_vat': False}" domain="[('tms_location','=',True),('parent_id','=',False)]" required="False"/>
                <field name="destination_locality_id" />
                <field name="cpe_id" />
                <field name="tag_ids" widget="many2many_tags"/>
            </field>
            <xpath expr="//group[@groups='!tms.group_tms_route']" position="replace" />
            <xpath expr="//group[@groups='tms.group_tms_route']" position="replace" />
            <xpath expr="//group//group" position="after" >
                <group>
                    <field name="driver_id"/>
                    <field name="driver_phone" widget="phone"/>
                    <label for="vehicle_id" string="Vehicle"/>
                    <div class="d-flex w-50">
                        <field name="vehicle_id" readonly="cpe_id" /><field name="trailer_id" />
                    </div>
                    
                    <label for="distance"/>
                    <div name="distance-val" class="d-flex w-25">
                        <field name="distance" class="text-end"/>
                        <span class="ms-1">Kms</span>
                    </div>
                    <label for="delivered"/>
                    <div name="delivered-val" class="d-flex w-25">
                        <field name="delivered" class="text-end"/>
                        <span class="ms-1">Kg</span>
                    </div>
                    <label for="delivered_extra"/>
                    <div name="delivered_extra-val" class="d-flex w-25">
                        <field name="delivered_extra" class="text-end"/>
                        <span class="ms-1">Kg</span>
                    </div>
                    <label for="delivered_total"/>
                    <div name="delivered_total-val" class="d-flex w-25">
                        <field name="delivered_total" class="text-end"/>
                        <span class="ms-1">Kg</span>
                    </div>
                    
                    
                </group>
            </xpath>
            <xpath expr="//page[@name='seats_page']" position="replace" />
            <button name="button_start_order" position="after">
                <button type="object" name="action_send_whatsapp_request">Send WA</button>
            </button>
        </field>
    </record>

    <record id="tms_order_view_kanban" model="ir.ui.view">
        <field name="name">tms.order.view.kanban.inherit.tms_shipment</field>
        <field name="model">tms.order</field>
        <field name="inherit_id" ref="tms.tms_order_view_kanban" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="start_trip" />
                <field name="customer_id" />
            </xpath>

            <xpath expr="//t[@t-esc='record.name.value']" position="replace">
                <t t-esc="record.customer_id.value" />
            </xpath>
            <xpath expr="//div[@class='oe_kanban_bottom_right']/field[@name='driver_id']"
                position="attributes">
                <attribute name="options">{'display_avatar_name': True}</attribute>
            </xpath>
        </field>
    </record>

    <record id="tms.action_tms_dash_order" model="ir.actions.act_window">
        <field name="name">Trips</field>
        <field name="res_model">tms.order</field>
        <field name="view_mode">tree,kanban,form</field>
        <field name="context">{'search_default_sale': 1, 'expand':1}</field>

    </record>
    <record id="ir_action_server_action_update_from_cpe" model="ir.actions.server">
        <field name="name">Update from CPE</field>
        <field name="model_id" ref="tms.model_tms_order"/>
        <field name="binding_model_id" ref="tms.model_tms_order"/>
        <field name="binding_view_types">form</field>
        <field name="groups_id" eval="[Command.link(ref('base.group_system'))]" />
        <field name="state">code</field>
        <field name="code">
            action = record.action_update_from_cpe()
        </field>
    </record>
