<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="sale_order_tms_view_kanban" model="ir.ui.view">
        <field name="name">sale_order.tms.view.kanban</field>
        <field name="model">sale.order</field>
        <field name="arch" type="xml">
            <kanban
                class="o_kanban_dashboard o_emphasize_colors"
                group_create="False"
                group_edit="False"
                create="0"
                js_class="tms_kanban"
            >
                <field name="partner_id" />
                <field name="partner_invoice_id" />
                <field name="tms_origin_id" />
                <field name="tms_destination_id" />
                <field name="tms_order_ids" />
                <field name="tag_ids" />
                <header>
                    <button name="action_create_tms_order" type="object"
                        class="o_button_create_tms_sale btn-primary" string="New"
                        display="always" />
                </header>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <!-- <div class="o_kanban_image">
                                <img
                                    t-att-src="kanban_image('res.partner', 'avatar_512', record.partner_id.raw_value)"
                                    t-att-title="record.partner_id.value"
                                    t-att-alt="record.partner_id.value"
                                    class="o_image_64_contain" />
                            </div> -->
                            <div class="oe_kanban_details">
                                <div class="text-muted o_row d-flex justify-content-end">
                                    
                                    <field name="create_date" widget="datetime" options="{'show_time': false}" />
                                </div>
                                <div class="o_kanban_record_top mb-0">
                                    <div class="o_kanban_record_headings">
                                        <strong class="o_kanban_record_title">
                                            <field name="partner_id" context="{'show_alias':True}"/>
                                        </strong>
                                        <t t-if="record.partner_invoice_id.raw_value != record.partner_id.raw_value">
                                            <div>
                                                <span>Para:</span>
                                                <strong class="o_kanban_record_title">
                                                    <field name="partner_invoice_id" context = "{'show_alias':True}"/>
                                                </strong>
                                            </div>
                                        </t>
                                    </div>
                                    <field name="tag_ids" widget="many2many_tags"/>
                                </div>                                
                                
                                <div class="text-muted o_row">
                                    <t t-esc="record.tms_origin_id.value" />
                                    <i
                                        class="fa fa-long-arrow-right mx-2 oe_read_only"
                                        aria-label="Arrow icon"
                                        title="Arrow"
                                    />
                                    <t
                                        t-esc="record.tms_destination_id.value"
                                    />
                                </div>
                                <div class="o_tms_orders o_row w-100 mt-1">
                                    <field name="tms_order_ids" widget="trips"
                                        options="{'color_field': 'color'}" 
                                        class="w-100"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_sale_order_tms_search" model="ir.ui.view">
        <field name="name">sale.order.tms.search</field>
        <field name="model">sale.order</field>
        <field name="arch" type="xml">
            <search>
                <filter string="Hoy" name="filter_today_creation" domain="[('create_date','&gt;', (context_today() - datetime.timedelta(days=1)).strftime('%Y-%m-%d'))]"/>
                <filter string="Active" name="tms_sale" domain="[('state', '=', 'sale'),]" />
            </search>
        </field>
    </record>
    
    <record id="action_tms_dash_sale" model="ir.actions.act_window">
        <field name="name">Orders</field>
        <field name="res_model">sale.order</field>
        <field name="search_view_id" ref="view_sale_order_tms_search" />
        <field name="context">
            {
            "search_default_has_tms_order": True,
            "search_default_tms_sale":True,
            "default_has_tms_order": True
            }
        </field>

        <field name="view_mode">kanban,tree,form</field>
        <field
            name="view_ids"
            eval="[
            (5, 0, 0),
            (0, 0, {'view_mode': 'kanban', 'view_id': ref('sale_order_tms_view_kanban')}),
            ]"
        />
    </record>

    <record id="view_order_form_inherit_tms_shipment" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.tms_shipment</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='order_lines']" position="before">
                <page string="Viajes" name="tms_orders">
                    <field name="tms_order_ids" mode="tree" />
                </page>
            </xpath>
        </field>
    </record>

    <menuitem
        id="menu_tms_dash_sale"
        name="Orders"
        action="action_tms_dash_sale"
        parent="tms.dashboard"
        sequence="10"
    />

</odoo>